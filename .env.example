# Example only — never commit real secrets.
# Copy to .env.local and fill values locally.
# Public project URL and publishable/anon key are safe for browser use only when RLS is correctly configured.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional server-side aliases. Never expose service-role/secret keys using NEXT_PUBLIC_.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Existing Cheki deployment settings (if applicable)
# CHEKI_URL=https://cheki.et
# NODE_ENV=development

# Required for subscription-code recovery on the server. Never prefix with NEXT_PUBLIC_.
# Generate 32 random bytes and base64-encode them before setting this variable.
# SUBSCRIPTION_CODE_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
